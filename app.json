{
  "expo": {
    "name": "MOVT",
    "slug": "movt",
    "scheme": "movt",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./src/assets/iconBuild.png",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dsvmTechnology.movtapp",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "background-fetch",
          "background-processing",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Este aplicativo precisa de acesso à sua localização para mostrar você no mapa e rastrear atividades de ciclismo.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Este aplicativo precisa de acesso à localização em segundo plano para rastrear suas rotas de exercício.",
        "NSLocationAlwaysUsageDescription": "Este aplicativo precisa de acesso à localização em segundo plano para rastrear suas rotas de corrida e ciclismo mesmo com a tela apagada.",
        "NSHealthShareUsageDescription": "Este aplicativo precisa de acesso aos seus dados de saúde para mostrar seu progresso fitness.",
        "NSHealthUpdateUsageDescription": "Este aplicativo precisa registrar seus dados de saúde para rastrear suas atividades.",
        "NSMotionUsageDescription": "Este aplicativo usa os sensores de movimento para contar seus passos e medir suas atividades físicas.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["instagram-stories", "instagram"]
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDTRVXtY25ARGfBPaFIqva84QeAgziJ9Ds"
        }
      },
      "package": "com.dsvmTechnology.movtapp",
      "googleServicesFile": "./google-services.json",
      "versionCode": 47,
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_SLEEP_SESSION",
        "android.permission.health.WRITE_STEPS",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.health.WRITE_TOTAL_CALORIES_BURNED",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "runtimeVersion": "1.0.0",
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-localization",
      "expo-web-browser",
      "expo-sensors",
      "expo-live-activity",
      "@bacons/apple-targets",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Este aplicativo precisa de acesso à localização em segundo plano para rastrear suas rotas de corrida e ciclismo mesmo com a tela apagada.",
          "locationAlwaysPermission": "Este aplicativo precisa de acesso à localização em segundo plano para rastrear suas rotas de corrida e ciclismo mesmo com a tela apagada.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#192126"
        }
      ],
      "./plugins/withNdkVersion.js",
      "./plugins/withHealthConnectManifest.js",
      "./plugins/withInstagramStories.js",
      "./plugins/withIosModularHeaders.js",
      "react-native-health-connect",
      "react-native-health",
      [
        "@sentry/react-native/expo",
        {
          "organization": "movt-app",
          "project": "react-native"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2d73320b-52df-4407-83d5-c827a5a55f27",
        "versionSource": "local"
      },
      "facebookAppId": "997090909849852"
    },
    "updates": {},
    "owner": "movtapp"
  }
}
